{
  "name": "edge_cases",
  "_help": "Spam, bad payloads, paid events, disconnects. Used by tools/run_integration.sh.",
  "steps": [
    {"log": "waiting for the overlay to connect + subscribe"},
    {"await_subscribed": true, "timeout": 30},
    {"log": "normal joins", "wait": 0.2},
    {"chat": {"user": "alice", "text": "!join", "display": "Alice"}},
    {"chat": {"user": "bob", "text": "!JOIN please", "display": "Bob"}},
    {"chat": {"user": "alice", "text": "!hi", "display": "Alice"}, "wait": 0.5},
    {"log": "one user spamming 40 commands"},
    {"spam": {"user": "spammer", "text": "!join", "count": 40, "interval": 0.01}},
    {"spam": {"user": "spammer2", "text": "!hi", "count": 40, "interval": 0.01}},
    {"spam": {"user": "spammer", "text": "!bonk alice", "count": 20, "interval": 0.01}, "wait": 0.3},
    {"log": "bad payloads"},
    {"raw": "{not json"},
    {"raw": "[]"},
    {"raw": "\"just a string\""},
    {"raw": "{\"event\":{\"source\":\"Twitch\"}}"},
    {"raw": ""},
    {"oversized": 90000},
    {"binary": true},
    {"event": {"source": "Twitch", "type": "ChatMessage", "data": {}}},
    {"event": {"source": "Twitch", "type": "ChatMessage", "data": {"message": "not an object"}}},
    {"event": {"source": "Twitch", "type": "ChatMessage", "data": {"message": {"userId": 12345, "message": 42}}}},
    {"wait": 0.3},
    {"log": "paid events forced at the client (it never subscribed to them)"},
    {"event": {"source": "Twitch", "type": "Cheer", "data": {"bits": 1000, "message": "!bonk streamer"}}, "force": true},
    {"event": {"source": "Twitch", "type": "GiftBomb", "data": {"gifts": 50}}, "force": true},
    {"event": {"source": "Kofi", "type": "Donation", "data": {"amount": "5.00"}}, "force": true},
    {"log": "weird names / text"},
    {"chat": {"user": "zalgo", "text": "!join\u0001\u0007", "display": "Z̵a̶lgo​<b>bold</b>‮evil_name_that_is_much_too_long_to_display"}},
    {"chat": {"user": "emoji", "text": "!bonk @Alice 🔨🔨🔨", "display": "Emoji🙂"}},
    {"chat": {"user": "nightbot", "text": "!join", "display": "Nightbot"}},
    {"chat": {"user": "plain", "text": "just chatting, no command"}},
    {"chat": {"user": "unknowncmd", "text": "!dance"}, "wait": 0.3},
    {"log": "crowd: 30 chatters bonking at once"},
    {"chatters": {"count": 30, "text": "!bonk alice", "interval": 0.02}},
    {"chatters": {"count": 30, "text": "!hi", "interval": 0.02}, "wait": 0.5},
    {"log": "follow burst + raid"},
    {"follow": {"user": "f1"}},
    {"follow": {"user": "f2"}},
    {"follow": {"user": "f3"}},
    {"raid": {"from": "coolstreamer", "viewers": 42}, "wait": 0.5},
    {"log": "channel point redeem (forced; redeems are off by default)"},
    {"redeem": {"user": "carol", "title": "Bonk the Streamer", "input": "@alice"}, "force": true, "wait": 0.5},
    {"log": "huge message (bigger than the WebSocket buffer): engine closes with 1009, client reconnects"},
    {"oversized": 400000, "wait": 0.5},
    {"await_subscribed": true, "timeout": 15},
    {"log": "abrupt disconnect"},
    {"disconnect": "abrupt", "wait": 0.5},
    {"await_subscribed": true, "timeout": 15},
    {"chat": {"user": "carol", "text": "!join"}, "wait": 0.5},
    {"log": "clean disconnect"},
    {"disconnect": "clean", "wait": 0.5},
    {"await_subscribed": true, "timeout": 15},
    {"log": "server down for 3s"},
    {"server_down": 3.0, "wait": 0.5},
    {"await_subscribed": true, "timeout": 20},
    {"chat": {"user": "dave", "text": "!join", "display": "Dave"}},
    {"chat": {"user": "erin", "text": "!bonk dave", "display": "Erin"}, "wait": 4.0}
  ]
}
