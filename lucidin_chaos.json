{
  "_help": "lucidin-chaos config. Every key is optional; anything missing uses the built-in default. Keys starting with _ are comments. See README.md#config-reference.",

  "streamerbot": {
    "host": "127.0.0.1",
    "port": 8080,
    "endpoint": "/",
    "password": "",
    "reconnect_initial_s": 1.0,
    "reconnect_max_s": 30.0,
    "handshake_timeout_s": 10.0,
    "max_message_bytes": 65536
  },

  "window": {
    "width": 1920,
    "height": 1080,
    "x": -1,
    "y": -1,
    "borderless": true,
    "transparent": true,
    "always_on_top": false,
    "click_through": true,
    "background_color": "#00000000",
    "max_fps": 60
  },

  "chat": {
    "command_prefix": "!",
    "ignore_users": ["streamelements", "nightbot", "streamlabs", "moobot"],
    "max_message_length": 300,
    "max_name_length": 25
  },

  "cooldowns": {
    "per_user_global_s": 2.0,
    "default_command_s": 10.0,
    "follow_global_s": 2.0,
    "raid_global_s": 30.0
  },

  "queue": {
    "capacity": 50,
    "max_pending_per_user": 2,
    "dispatch_per_second": 4.0
  },

  "redeems": {
    "_help": "Optional channel point redeems (Affiliate+). Off by default. Map each reward TITLE (as written on Twitch) to a chat command.",
    "enabled": false,
    "bypass_user_cooldowns": true,
    "rewards": {
      "Bonk the Streamer": { "command": "bonk", "args_from_input": true }
    }
  },

  "modules": {
    "critter_race": {
      "enabled": true,
      "region": [100, 740, 1720, 320],
      "lanes": 6,
      "min_humans_to_start": 3,
      "lobby_timeout_s": 30.0,
      "countdown_s": 3.0,
      "results_s": 6.0,
      "cooldown_s": 10.0,
      "max_race_s": 45.0,
      "base_speed": 0.08,
      "speed_jitter": 0.35,
      "join_cooldown_s": 5.0,
      "raid_race": true,
      "panel_color": "#00000066",
      "text_color": "#ffffff",
      "npc_names": ["Pebble", "Noodle", "Biscuit", "Gizmo", "Waffle", "Pickle", "Mochi", "Sprout", "Bean", "Nugget"],
      "critters": [
        {"shape": "circle", "color": "#ff6b6b", "size": 34, "sprite": ""},
        {"shape": "square", "color": "#ffd93d", "size": 30, "sprite": ""},
        {"shape": "triangle", "color": "#6bcb77", "size": 38, "sprite": ""},
        {"shape": "circle", "color": "#4d96ff", "size": 28, "sprite": ""},
        {"shape": "square", "color": "#c77dff", "size": 36, "sprite": ""},
        {"shape": "triangle", "color": "#ff9f1c", "size": 32, "sprite": ""},
        {"shape": "circle", "color": "#2ec4b6", "size": 40, "sprite": ""},
        {"shape": "square", "color": "#f15bb5", "size": 26, "sprite": ""},
        {"shape": "triangle", "color": "#e0e0e0", "size": 34, "sprite": ""}
      ],
      "npc_critters": [
        {"shape": "circle", "color": "#8d99ae", "size": 26, "sprite": ""},
        {"shape": "square", "color": "#adb5bd", "size": 24, "sprite": ""},
        {"shape": "triangle", "color": "#6c757d", "size": 28, "sprite": ""}
      ],
      "raider_critter": {"shape": "triangle", "color": "#ff5d8f", "size": 56, "sprite": ""},
      "seed": 0
    },
    "greeter": {
      "enabled": true,
      "region": [60, 160, 1800, 300],
      "duration_s": 3.0,
      "cooldown_s": 30.0,
      "show_follows": true,
      "show_raids": true,
      "max_on_screen": 12,
      "shapes": [
        {"shape": "circle", "color": "#ffd166", "size": 36, "sprite": ""},
        {"shape": "square", "color": "#06d6a0", "size": 32, "sprite": ""},
        {"shape": "triangle", "color": "#118ab2", "size": 40, "sprite": ""}
      ],
      "follow_shape": {"shape": "circle", "color": "#ef476f", "size": 44, "sprite": ""},
      "raid_shape": {"shape": "triangle", "color": "#f78c6b", "size": 90, "sprite": ""},
      "seed": 0
    }
  },

  "debug": {
    "show_regions": false,
    "log_events": false,
    "show_status": true
  }
}
